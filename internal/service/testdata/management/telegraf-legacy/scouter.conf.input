server_id=synthetic-server
input_telegraf_enabled=true
input_telegraf_delta_counter_normalize_default=false
input_telegraf_$leg$_enabled=true
input_telegraf_$leg$_counter_mappings=gauge:leg_gauge_$port$:Gauge $port$:cnt:true,&bytes:leg_bytes::b,&&reqs:leg_reqs:Reqs:cnt:true:30,short:leg_short
input_telegraf_$leg$_objFamily_base=LEG_FAMILY
input_telegraf_$leg$_objType_base=LEG_TYPE
input_telegraf_$leg$_objType_prepend_tags=
input_telegraf_$leg$_objType_append_tags=tier
input_telegraf_$leg$_objType_icon=linux
input_telegraf_$leg$_objName_base=LEG_NAME
input_telegraf_$leg$_objName_append_tags=port
input_telegraf_$leg$_host_tag=hostname
input_telegraf_$leg$_host_mappings=raw-host:mapped-host,broken
input_telegraf_$leg$_tag_filter=tier:web,tier:!skip,bad
input_telegraf_$legoff$_enabled=false
input_telegraf_$legoff$_objFamily_base=LEGOFF
input_telegraf_$legoff$_counter_mappings=v:legoff_v
